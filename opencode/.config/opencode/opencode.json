  "agent": {
    "steroids": {
      "mode": "primary",
      "model": "omlx/gpt-oss-20b-MXFP4-Q8",
      "color": "primary",
      "permission": {
        "*": "ask",

        "list": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "websearch": "allow",
        "question": "allow",
        "mcp": "allow",

        "edit": "ask",
        "write": "ask",
        // --- Secrets & sensitive file guards ---
        "read:.env": "deny",
        "read:.env.*": "deny",
        "read:**/.env": "deny",
        "read:**/.env.*": "deny",
        "read:**/*.pem": "deny",
        "read:**/*.key": "deny",
        "read:**/*.pfx": "deny",
        "read:**/*.p12": "deny",
        "read:**/secrets/**": "deny",
        "write:.env": "deny",
        "write:.env.*": "deny",
        "write:**/.env": "deny",
        "write:**/.env.*": "deny",
        "edit:.env": "deny",
        "edit:.env.*": "deny",

        "bash": {
          "*": "ask",

          "kubectl get *": "allow",
          "kubectl describe *": "allow",
          "kubectl logs *": "allow",
          "kubectl top *": "allow",
          "kubectl config current-context": "allow",
          "kubectl config get-contexts": "allow",

          "kubectl apply *": "ask",
          "kubectl delete *": "ask",
          "kubectl scale *": "ask",
          "kubectl rollout *": "ask",
          "kubectl exec *": "ask"
        }
      },
      "prompt": "{file:./prompts/steroids.txt}"
    },

    // ── ORCHESTRATOR ────────────────────────────────────────────────
    // PRIMARY. You live here. Plans, reasons, coordinates subagents.
    // Read-only bash. Does not implement or write wiki directly.
    // Low token volume — Opus cost is justified.
    //
    // Cloud fallback: github-copilot/gpt-5.4 ($8/1M) if Opus budget is tight.
    "orchestrator": {
      "description": "Senior SRE orchestrator. Plans complex tasks, coordinates scout and executor subagents, and maintains overall session context. Use for any multi-step, multi-system, or production-impacting work.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.4",
      "color": "secondary",
      "temperature": 0.1,
      "permission": {
        "*": "deny",
        "list": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "question": "allow",
        "mcp": "allow",
        "edit": "deny",
        "write": "deny",
        "task": {
          "*": "deny",
          "scout": "allow",
          "executor": "ask"
        },
        "bash": {
          "*": "deny",
          "kubectl get *": "allow",
          "kubectl describe *": "allow",
          "kubectl logs *": "allow",
          "kubectl top *": "allow",
          "kubectl config current-context": "allow",
          "kubectl config get-contexts": "allow",
          "terraform plan *": "allow",
          "terraform show *": "allow",
          "az * show *": "allow",
          "az * list *": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git status": "allow"
        }
      },
      "prompt": "{file:./prompts/orchestrator.txt}"
    },

    // ── EXECUTOR ────────────────────────────────────────────────────
    // SUBAGENT. Implementation. Invoked by orchestrator or via @executor.
    // Full tool access, all mutations ask-gated.
    //
    // LOCAL FIRST: gpt-oss-20b — already working, strong tool use and
    //   function calling at 62K context, designed for agentic workflows.
    //   Switch to Qwen3.6 for heavier code/repo tasks.
    //
    // Cloud fallbacks (swap model string):
    //   github-copilot/claude-sonnet-4-6  $15/1M — best Anthropic accuracy
    //   github-copilot/gpt-5.4             $8/1M — cheaper, good general tasks
    "executor": {
      "description": "Full-access implementation agent. Writes code, edits files, runs bash, applies Terraform and kubectl changes. Invoke for concrete implementation work once the approach is decided. Can be spawned in parallel for independent subtasks.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.3-codex",
      "color": "primary",
      "temperature": 0.2,
      "permission": {
        "*": "ask",
        "list": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "question": "allow",
        "mcp": "allow",
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "kubectl get *": "allow",
          "kubectl describe *": "allow",
          "kubectl logs *": "allow",
          "kubectl top *": "allow",
          "kubectl config current-context": "allow",
          "kubectl config get-contexts": "allow",
          "kubectl apply *": "ask",
          "kubectl delete *": "ask",
          "kubectl scale *": "ask",
          "kubectl rollout *": "ask",
          "kubectl exec *": "ask",
          "kubectl patch *": "ask",
          "terraform apply *": "ask",
          "terraform destroy *": "ask",
          "az * create *": "ask",
          "az * delete *": "ask",
          "az * update *": "ask",
          "git commit *": "ask",
          "git push *": "ask",
          "git checkout *": "ask",
          "docker run *": "ask",
          "docker exec *": "ask"
        }
      },
      "prompt": "{file:./prompts/executor.txt}"
    },

    // ── SCOUT ───────────────────────────────────────────────────────
    // SUBAGENT. Cheap read-only triage. Invoked automatically before
    // expensive orchestrator reasoning, or manually via @scout.
    //
    // LOCAL: gemma-4-26B-A4B — only 3.8B active params, very fast,
    //   good reading comprehension. Ideal for quick file/state triage
    //   where you want a summary, not deep reasoning.
    //
    // Cloud fallback: github-copilot/gpt-5.4-mini ($1.60/1M output)
    "scout": {
      "description": "Cheap read-only triage agent. Reads files, greps patterns, checks git/kubectl/terraform/az state, returns a compact summary. Invoke before expensive planning to gather context cheaply. Does not plan or implement.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.4-mini",
      "temperature": 0.0,
      "steps": 20,
      "permission": {
        "*": "deny",
        "list": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "question": "allow",
        "todowrite": "allow",
        "bash": {
          "*": "deny",
          "kubectl get *": "allow",
          "kubectl describe *": "allow",
          "kubectl logs *": "allow",
          "kubectl config current-context": "allow",
          "kubectl config get-contexts": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git status": "allow",
          "terraform show *": "allow",
          "az * list *": "allow",
          "az * show *": "allow"
        }
      },
      "prompt": "{file:./prompts/scout.txt}"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "drawio": {
      "type": "local",
      "command": ["npx", "-y", "@drawio/mcp"],
      "enabled": false
    },
    "azure-pricing": {
      "type": "remote",
      "url": "https://mcp-azure-pricing.andybarber.dev/sse",
      "enabled": false
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
      "enabled": false
    },

    "azure-devops": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp",
        "sortedproapp",
        "-d",
        "core",
        "work",
        "work-items",
        "repositories",
        "pipelines"
      ],
      "enabled": false
    }
  },

  "tools": {
    "write": true,
    "edit": true,
    "bash": true,
    "mcp": true
  },

  "permission": {
    "*": "ask",
    "edit": "ask",
    "bash": "ask"
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/.nuxt/**",
      "**/coverage/**",
      "**/bin/**",
      "**/obj/**",
      "**/vendor/**",
      "**/.terraform/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/*.log"
    ]
  },

  "formatter": {
    "javascript": {
      "command": ["prettier", "--write"],
      "extensions": [".js", ".jsx", ".ts", ".tsx"]
    },
    "python": {
      "command": ["black", "-"],
      "extensions": [".py"]
    }
  },
  "lsp": true
}
